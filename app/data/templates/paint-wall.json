{
  "template_id": "paint_wall",
  "project_id": "PRJ-05",
  "version": "1.0.0",
  "comment": "DR-04 template from the project catalogue PRJ-05 (draft). Indoor walls, 2 coats, incl. small mould treatment. Basic level: no wall or load questions. Team review pending (SR-10).",
  "review": {
    "status": "pending_team_review",
    "reviewed_by": null,
    "review_date": null,
    "created": "2026-10-27",
    "source": "data/project_catalogue.xlsx (draft v1, 27 Oct 2026)"
  },
  "title": {
    "en": "Paint a wall",
    "de": "Wand streichen"
  },
  "icon": "paint",
  "group": {
    "en": "Decorating",
    "de": "Renovieren"
  },
  "safety_level": "basic",
  "safety_factor": 1.25,
  "wall_limits": {},
  "required_facts": [
    "wall_width_m",
    "room_height_m",
    "surface",
    "mould",
    "health",
    "old_coating"
  ],
  "questions": [
    {
      "id": "Q1",
      "type": "group",
      "text": {
        "en": "Your room",
        "de": "Ihr Raum"
      },
      "help": {
        "en": "Add up the widths of all walls you want to paint.",
        "de": "Zählen Sie die Breiten aller Wände zusammen, die Sie streichen möchten."
      },
      "fields": [
        {
          "fact": "wall_width_m",
          "type": "number",
          "unit": "m",
          "min": 0.5,
          "max": 200,
          "label": {
            "en": "Total width of the walls",
            "de": "Gesamtbreite der Wände"
          }
        },
        {
          "fact": "room_height_m",
          "type": "number",
          "unit": "m",
          "min": 1.5,
          "max": 6,
          "label": {
            "en": "Room height",
            "de": "Raumhöhe"
          }
        },
        {
          "fact": "surface",
          "type": "choice",
          "options": [
            "new",
            "painted",
            "wallpaper"
          ],
          "option_labels": {
            "new": {
              "en": "New plaster or plasterboard",
              "de": "Neuer Putz oder Gipskarton"
            },
            "painted": {
              "en": "Painted",
              "de": "Gestrichen"
            },
            "wallpaper": {
              "en": "Wallpaper",
              "de": "Tapete"
            }
          },
          "label": {
            "en": "Surface",
            "de": "Untergrund"
          }
        }
      ]
    },
    {
      "id": "Q2",
      "type": "group",
      "text": {
        "en": "Condition",
        "de": "Zustand"
      },
      "fields": [
        {
          "fact": "mould",
          "type": "choice",
          "options": [
            "none",
            "small",
            "large"
          ],
          "option_labels": {
            "none": {
              "en": "None",
              "de": "Keiner"
            },
            "small": {
              "en": "Small, surface only (< 0.5 m²)",
              "de": "Klein, nur oberflächlich (< 0,5 m²)"
            },
            "large": {
              "en": "Larger or deep in the wall",
              "de": "Größer oder tief in der Wand"
            }
          },
          "label": {
            "en": "Mould on the wall?",
            "de": "Schimmel an der Wand?"
          }
        },
        {
          "fact": "health",
          "type": "choice",
          "label": {
            "en": "Mould allergy or respiratory illness in the household?",
            "de": "Schimmelallergie oder Atemwegserkrankung im Haushalt?"
          },
          "options": [
            "no",
            "yes"
          ],
          "option_labels": {
            "no": {
              "en": "No",
              "de": "Nein"
            },
            "yes": {
              "en": "Yes",
              "de": "Ja"
            }
          }
        },
        {
          "fact": "old_coating",
          "type": "choice",
          "label": {
            "en": "Building before 1993 and old coating to sand or strip?",
            "de": "Gebäude vor 1993 und alte Beschichtung abschleifen oder entfernen?"
          },
          "options": [
            "no",
            "yes"
          ],
          "option_labels": {
            "no": {
              "en": "No",
              "de": "Nein"
            },
            "yes": {
              "en": "Yes",
              "de": "Ja"
            }
          }
        }
      ]
    }
  ],
  "stops": [
    {
      "id": "area",
      "rule_id": "ST-04",
      "hand_off": "staff",
      "message": {
        "en": "This size is outside this guide. Please ask OBI staff.",
        "de": "Diese Größe liegt außerhalb dieser Anleitung. Bitte OBI-Personal fragen."
      },
      "when": {
        "gt": [
          {
            "mul": [
              {
                "fact": "wall_width_m"
              },
              {
                "fact": "room_height_m"
              }
            ]
          },
          60
        ]
      },
      "help": {
        "en": "This guide covers up to 60 m² of wall.",
        "de": "Diese Anleitung gilt für bis zu 60 m² Wandfläche."
      }
    },
    {
      "id": "working_height",
      "rule_id": "ST-04",
      "hand_off": "staff",
      "message": {
        "en": "This size is outside this guide. Please ask OBI staff.",
        "de": "Diese Größe liegt außerhalb dieser Anleitung. Bitte OBI-Personal fragen."
      },
      "when": {
        "gt": [
          {
            "fact": "room_height_m"
          },
          2.5
        ]
      },
      "help": {
        "en": "This guide covers working heights up to 2.5 m (step ladder and pole).",
        "de": "Diese Anleitung gilt für Arbeitshöhen bis 2,5 m (Stufenleiter und Teleskopstange)."
      }
    },
    {
      "id": "mould_large",
      "rule_id": "ST-07",
      "hand_off": "professional",
      "when": {
        "fact_in": {
          "fact": "mould",
          "values": [
            "large"
          ]
        }
      },
      "message": {
        "en": "Larger mould must be removed by a specialist company.",
        "de": "Größerer Schimmelbefall gehört in die Hände eines Fachbetriebs."
      }
    },
    {
      "id": "mould_health",
      "rule_id": "ST-08",
      "hand_off": "professional",
      "when": {
        "all": [
          {
            "fact_in": {
              "fact": "mould",
              "values": [
                "small"
              ]
            }
          },
          {
            "fact_in": {
              "fact": "health",
              "values": [
                "yes"
              ]
            }
          }
        ]
      },
      "message": {
        "en": "Please do not remove the mould yourself; ask a specialist.",
        "de": "Bitte entfernen Sie den Schimmel nicht selbst; fragen Sie einen Fachbetrieb."
      }
    },
    {
      "id": "old_coating",
      "rule_id": "ST-09",
      "hand_off": "professional",
      "when": {
        "fact_in": {
          "fact": "old_coating",
          "values": [
            "yes"
          ]
        }
      },
      "message": {
        "en": "Old coatings may contain harmful substances. Please have them checked before sanding.",
        "de": "Alte Beschichtungen können Schadstoffe enthalten. Bitte vor dem Schleifen prüfen lassen."
      }
    }
  ],
  "warnings": [
    {
      "id": "switch_covers",
      "rule_id": "ST-14",
      "text": {
        "en": "Removing switch or socket covers: switch off the circuit first. Only remove cover frames – never touch the wiring.",
        "de": "Schalter- oder Steckdosenabdeckungen abnehmen: zuerst die Sicherung ausschalten. Nur Abdeckrahmen abnehmen – nie an die Leitungen."
      }
    }
  ],
  "variables": {
    "area_m2": {
      "rule_id": "PAINT-Q1",
      "expr": {
        "mul": [
          {
            "fact": "wall_width_m"
          },
          {
            "fact": "room_height_m"
          }
        ]
      }
    },
    "litres": {
      "rule_id": "PAINT-Q1",
      "comment": "area × 2 coats ÷ coverage (catalogue specs coverage_m2_per_l)",
      "expr": {
        "div": [
          {
            "mul": [
              {
                "var": "area_m2"
              },
              2
            ]
          },
          {
            "spec": "paint.coverage_m2_per_l"
          }
        ]
      }
    }
  },
  "methods": [
    {
      "method_id": "roller",
      "rule_id": "PAINT-M1",
      "penetrates_wall": false,
      "drilling": false,
      "label": {
        "en": "Roller, 2 coats",
        "de": "Rolle, 2 Anstriche"
      },
      "roles": [
        {
          "role": "paint",
          "section": "materials",
          "rule_ids": [
            "PAINT-Q1"
          ],
          "label": {
            "en": "Wall paint",
            "de": "Wandfarbe"
          },
          "select": {
            "variant_groups": [
              "interior-wall-paint-matt",
              "colour-wall-paint"
            ],
            "prefer": [
              "-spec.volume_l",
              "price_eur"
            ]
          },
          "on_none": "stop",
          "ownable": true,
          "quantity": {
            "rule_id": "PAINT-Q1",
            "units": {
              "ceil": {
                "div": [
                  {
                    "var": "litres"
                  },
                  {
                    "spec": "paint.volume_l"
                  }
                ]
              }
            }
          }
        },
        {
          "role": "mould_paint",
          "section": "materials",
          "rule_ids": [
            "PAINT-Q2",
            "S-03"
          ],
          "label": {
            "en": "Anti-mould wall paint",
            "de": "Anti-Schimmel-Wandfarbe"
          },
          "select": {
            "product_nrs": [
              "P076"
            ]
          },
          "on_none": "unresolved",
          "quantity": {
            "rule_id": "PAINT-Q2",
            "units": {
              "ceil": {
                "div": [
                  {
                    "div": [
                      {
                        "mul": [
                          0.5,
                          2
                        ]
                      },
                      {
                        "spec": "mould_paint.coverage_m2_per_l"
                      }
                    ]
                  },
                  {
                    "spec": "mould_paint.volume_l"
                  }
                ]
              }
            }
          },
          "ownable": true,
          "when": {
            "fact_in": {
              "fact": "mould",
              "values": [
                "small"
              ]
            }
          }
        },
        {
          "role": "primer",
          "section": "materials",
          "rule_ids": [
            "PAINT-C1"
          ],
          "label": {
            "en": "Deep primer",
            "de": "Tiefengrund"
          },
          "select": {
            "product_nrs": [
              "P074"
            ]
          },
          "on_none": "unresolved",
          "quantity": {
            "rule_id": "PAINT-Q0",
            "units": 1
          },
          "ownable": true,
          "when": {
            "fact_in": {
              "fact": "surface",
              "values": [
                "new"
              ]
            }
          }
        },
        {
          "role": "filler",
          "section": "materials",
          "rule_ids": [
            "PAINT-C2"
          ],
          "label": {
            "en": "Wall filler",
            "de": "Spachtelmasse"
          },
          "select": {
            "product_nrs": [
              "P012"
            ]
          },
          "on_none": "unresolved",
          "quantity": {
            "rule_id": "PAINT-Q0",
            "units": 1
          },
          "ownable": true
        },
        {
          "role": "mould_remover",
          "section": "materials",
          "rule_ids": [
            "S-03"
          ],
          "label": {
            "en": "Mould remover, chlorine-free",
