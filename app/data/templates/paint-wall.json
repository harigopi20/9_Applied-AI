  "rule_texts": {
    "PAINT-M1": {
      "en": "Indoor walls, 2 coats with a roller.",
      "de": "Innenwände, 2 Anstriche mit der Rolle."
    },
    "PAINT-Q0": {
      "en": "1 per project",
      "de": "1 pro Projekt"
    },
    "PAINT-Q1": {
      "en": "litres = wall width × room height × 2 coats ÷ coverage (7 m²/l), rounded up to whole buckets",
      "de": "Liter = Wandbreite × Raumhöhe × 2 Anstriche ÷ Ergiebigkeit (7 m²/l), auf ganze Eimer aufgerundet"
    },
    "PAINT-Q2": {
      "en": "treated area (max. 0.5 m²) × 2 coats ÷ 7 m²/l, rounded up to whole cans",
      "de": "behandelte Fläche (max. 0,5 m²) × 2 Anstriche ÷ 7 m²/l, auf ganze Dosen aufgerundet"
    },
    "PAINT-Q3": {
      "en": "1 roll per started 15 m of edges (ceiling and floor line = 2 × wall width)",
      "de": "1 Rolle je angefangene 15 m Kante (Decken- und Bodenlinie = 2 × Wandbreite)"
    },
    "PAINT-C1": {
      "en": "for absorbent surfaces (new plaster or plasterboard)",
      "de": "für saugende Untergründe (neuer Putz oder Gipskarton)"
    },
    "PAINT-C2": {
      "en": "for holes or cracks",
      "de": "für Löcher oder Risse"
    },
    "PAINT-C3": {
      "en": "rooms higher than 2.0 m",
      "de": "Räume höher als 2,0 m"
    }
  }
}
