  "rule_texts": {
    "LOCK-M1": {
      "en": "The new lock must match type, backset and distance of the old one.",
      "de": "Das neue Schloss muss Art, Dornmaß und Entfernung des alten haben."
    },
    "LOCK-Q0": {
      "en": "1 per door",
      "de": "1 pro Tür"
    },
    "LOCK-C1": {
      "en": "only for profile cylinder locks (PZ)",
      "de": "nur für Profilzylinderschlösser (PZ)"
    },
    "LOCK-C2": {
      "en": "if the old handles are worn – otherwise tick \"I have this\"",
      "de": "wenn die alten Drücker abgenutzt sind – sonst „Habe ich schon“ wählen"
