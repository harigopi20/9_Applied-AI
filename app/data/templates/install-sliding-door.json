  "rule_texts": {
    "SLIDE-M1": {
      "en": "Rail above the opening on a solid wall; rail and plugs must each carry the door weight × 1.25.",
      "de": "Schiene über der Öffnung an einer massiven Wand; Schiene und Dübel müssen jeweils das Türgewicht × 1,25 tragen."
    },
    "SLIDE-Q0": {
      "en": "1 per door",
      "de": "1 pro Tür"
    },
    "SLIDE-Q1": {
      "en": "number as in the rail's mounting instructions",
      "de": "Anzahl laut Montageanleitung der Schiene"
    },
    "SLIDE-Q2": {
      "en": "1 handle per side (2 per door)",
      "de": "1 Griff je Seite (2 pro Tür)"
    },
    "SLIDE-L1": {
      "en": "door leaf at least as wide as the opening",
      "de": "Türblatt mindestens so breit wie die Öffnung"
    },
    "SLIDE-L2": {
      "en": "rail ≥ 2 × door width, rated door width ≥ leaf width",
      "de": "Schiene ≥ 2 × Türbreite, zugelassene Türbreite ≥ Türblattbreite"
    },
    "SLIDE-T1": {
      "en": "Screwdriver that fits the screws",
      "de": "Schraubendreher passend zu den Schrauben"
    },
    "SLIDE-T2": {
      "en": "Measuring and levelling for every mounting job",
      "de": "Messen und Ausrichten bei jeder Montage"
    }
  }
}
