  "rule_texts": {
    "WP-M1": {
      "en": "Paste goes on the wall, dry strips are hung (nonwoven wallpaper).",
      "de": "Kleister an die Wand, trockene Bahnen anlegen (Vliestapete)."
    },
    "WP-Q0": {
      "en": "1 per project",
      "de": "1 pro Projekt"
    },
    "WP-Q1": {
      "en": "strips per roll = ⌊10.05 m ÷ (room height + 0.10 m + repeat)⌋; strips = ⌈wall width ÷ 0.53 m⌉; rolls = ⌈strips ÷ strips per roll⌉",
      "de": "Bahnen je Rolle = ⌊10,05 m ÷ (Raumhöhe + 0,10 m + Rapport)⌋; Bahnen = ⌈Wandbreite ÷ 0,53 m⌉; Rollen = ⌈Bahnen ÷ Bahnen je Rolle⌉"
    },
    "WP-Q2": {
      "en": "1 pack of paste per 5 rolls",
      "de": "1 Packung Kleister je 5 Rollen"
    },
    "WP-C1": {
      "en": "for uneven or dark surfaces",
      "de": "für unebene oder dunkle Untergründe"
    },
    "WP-C2": {
      "en": "for absorbent surfaces",
      "de": "für saugende Untergründe"
    },
    "WP-C3": {
      "en": "for holes or cracks",
      "de": "für Löcher oder Risse"
    }
  }
}
