{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),R=process.cwd(),T={'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8','.css':'text/css','.json':'application/json','.csv':'text/csv','.svg':'image/svg+xml','.png':'image/png','.woff2':'font/woff2','.xlsx':'application/octet-stream'};h.createServer((q,s)=>{const u=decodeURIComponent(new URL(q.url,'http://x').pathname);let fp=p.join(R,p.normalize(u));if(u.endsWith('/'))fp=p.join(fp,'index.html');if(!fp.startsWith(R)){s.writeHead(403);return s.end()}f.readFile(fp,(e,b)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream'});s.end(b)})}).listen(process.env.PORT||8000,'127.0.0.1')"],
      "port": 8000
    }
  ]
}
